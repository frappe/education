{
  // Used only by vitest. Same bindings as wrangler.jsonc but no static assets,
  // so tests do not need the web app to be built first.
  "name": "ptv-lms-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "vars": {
    "ENVIRONMENT": "test",
    "EMAIL_MODE": "dev",
    "APP_URL": "https://lms.test",
    "GOOGLE_CLIENT_ID": "test-client-id.apps.googleusercontent.com",
    "GOOGLE_CLIENT_SECRET": "test-client-secret",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ptv-lms-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
}
