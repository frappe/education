{
  // Used only by vitest. Same bindings as wrangler.jsonc but no static assets,
  // so tests do not need the web app to be built first.
  "name": "ptv-lms-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ENVIRONMENT": "test", "EMAIL_MODE": "dev" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ptv-lms-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
}
